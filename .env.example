# Copy to .env.local and fill in.
# Never commit real keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers -----------------------------------------------------------
# The tutor LLM uses any OpenAI-compatible API. Two common setups:
#
# Gemini (recommended for a free/cheap start):
#   OPENAI_API_KEY=<your Gemini key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   TUTOR_MODEL=gemini-3.8-flash
#
# OpenAI (one key drives STT+LLM+TTS):
OPENAI_API_KEY=
# or GROQ_API_KEY= if you use Groq Whisper

# Local stack (M4 Mac mini example). Each piece can point at a different
# OpenAI-compatible server; unset vars fall back to OPENAI_* above.
#   STT_BASE_URL=http://localhost:8080/in/v1        # whisper.cpp server
#   OPENAI_BASE_URL=http://localhost:1234/v1        # LM Studio (LLM)
#   TTS_BASE_URL=http://localhost:8880/v1           # kokoro-fastapi
#   TTS_MODEL=kokoro / TTS_VOICE=af_heart
#
# kokoro via Docker (ONNX mode — the PyTorch model OOMs on a 2GB Docker VM):
#   docker run -d --name kokoro-tts --restart unless-stopped -p 8880:8880 \
#     -e USE_ONNX=1 ghcr.io/remsky/kokoro-fastapi-cpu
# STT_API_KEY= / TTS_API_KEY= are only needed if the local server requires one.

TUTOR_MODEL=gpt-4o-mini
STT_MODEL=whisper-1
TTS_MODEL=tts-1
TTS_VOICE=nova

# Privacy: recorded audio older than this many days is deleted automatically
# (0 or unset = keep forever; 14 is a sensible default)
AUDIO_RETENTION_DAYS=14

# --- v2: streaming + duplex (not built yet) ---------------------------------
# To feel like Duolingo video chat you need VAD + interruption handling.
# See ROADMAP.md before adding agents/RAG/duplex.
# Jev decision AI (sentence scoring + difficulty control). Output tokens are free.
# TYPESAFE_API_KEY=

# --- accounts (multi-user, 2026-09-23) ---
# Seeded admin account on first run:
ADMIN_USERNAME=yoon
ADMIN_PASSWORD=change-me
# Signup invite code (empty = open signup):

# whisper.cpp (로컬 전사 서버, launchd com.whisper.server):
# brew install whisper-cpp && 모델 ~/.whisper-models/ggml-small.en.bin
